{
  "name": "bug-cam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 4204 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo": "BUGCAM_DEMO=1 playwright test tests/demo.spec.ts",
    "check": "npm run build && npm run test && npm run e2e"
  },
  "dependencies": {
    "express": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@types/express": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "concurrently": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
